generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  displayName        String
  passwordHash       String?
  teamId             String?
  team               Team?            @relation(fields: [teamId], references: [id])
  walletAddress      String?          @unique
  role               UserRole         @default(AUTHOR)
  sigCreditBalance       Int              @default(100)
  penalties              Int              @default(0)
  uploadBannedUntil      DateTime?
  citationViolationCount Int              @default(0)
  createdAt              DateTime         @default(now())
  submittedPapers        Paper[]          @relation("PaperSubmitter")
  authoredPapers         PaperAuthor[]
  ownedAgents            Agent[]          @relation("AgentOwner")
  ownedReviews           Review[]         @relation("ReviewOwner")
  votes                  ReviewVote[]
  sessions               AuthSession[]
  sigTransactions        SigTransaction[]
  citationViolations     CitationViolation[]
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  agents    Agent[]
  reviews   Review[] @relation("ReviewTeam")
}

model Agent {
  id              String            @id @default(cuid())
  slug            String            @unique
  name            String
  loginIdentifier String            @unique
  secretHash      String
  modelName       String
  specialty       String
  status          AgentStatus       @default(ACTIVE)
  ownerId         String
  owner           User              @relation("AgentOwner", fields: [ownerId], references: [id])
  teamId          String?
  team            Team?             @relation(fields: [teamId], references: [id])
  reviews         Review[]
  sessions        AuthSession[]
  recruitments    Recruitment[]
  agentVotesCast  AgentReviewVote[] @relation("VoterAgent")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([ownerId, name])
}

model AuthSession {
  id          String      @id @default(cuid())
  tokenHash   String      @unique
  kind        SessionKind
  userId      String?
  agentId     String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id])
  agent       Agent?      @relation(fields: [agentId], references: [id])

  @@index([kind, userId])
  @@index([kind, agentId])
}

model AuthThrottle {
  id             String       @id @default(cuid())
  scope          AuthScope
  identifier     String
  failedCount    Int          @default(0)
  lockedUntil    DateTime?
  lastAttemptAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([scope, identifier])
}

model Paper {
  id                String          @id @default(cuid())
  slug              String          @unique
  title             String
  category          String
  abstract          String
  contentMarkdown   String
  status            PaperStatus     @default(DRAFT)
  creditsLocked     Int             @default(0)
  roundsRequired    Int             @default(2)
  submittedById     String
  submittedBy       User            @relation("PaperSubmitter", fields: [submittedById], references: [id])
  authors           PaperAuthor[]
  revisions         RevisionRound[]
  reviews           Review[]
  checklist         ReviewChecklist?
  recruitments      Recruitment[]
  citationViolations CitationViolation[]
  citationPledge    Boolean         @default(false)
  publishedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model ReviewChecklist {
  id        String   @id @default(cuid())
  paperId   String   @unique
  paper     Paper    @relation(fields: [paperId], references: [id])
  items     Json
  createdAt DateTime @default(now())
}

model PaperAuthor {
  id        String   @id @default(cuid())
  paperId   String
  userId    String
  sortOrder Int
  paper     Paper    @relation(fields: [paperId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([paperId, userId])
  @@unique([paperId, sortOrder])
}

model Review {
  id                    String               @id @default(cuid())
  paperId               String
  reviewerAgentId       String
  reviewerOwnerId       String
  reviewerTeamId        String?
  reviewerAgent         Agent                @relation(fields: [reviewerAgentId], references: [id])
  reviewerOwner         User                 @relation("ReviewOwner", fields: [reviewerOwnerId], references: [id])
  reviewerTeam          Team?                @relation("ReviewTeam", fields: [reviewerTeamId], references: [id])
  paper                 Paper                @relation(fields: [paperId], references: [id])
  coreClaim             String
  assumptions           String
  failureMode           String
  alternativeHypothesis String
  verificationProposal  String
  logicalWeakness       String
  impactScore           Int
  recommendation        Recommendation
  citationIntegrityFlag Boolean              @default(false)
  citationConcerns      String?
  rubricNovelty         Int?
  rubricSoundness       Int?
  rubricImpact          Int?
  rubricClarity         Int?
  rubricValidation      Int?
  rubricReproducibility Int?
  rubricEthics          Int?
  qualityScore          Float?
  diversityScore        Float?
  upvoteCount           Int                  @default(0)
  similarityScore       Float?
  disqualified          Boolean              @default(false)
  disqualificationReason String?
  selectedTop3          Boolean              @default(false)
  votes                 ReviewVote[]
  agentVotes            AgentReviewVote[]
  createdAt             DateTime             @default(now())

  @@unique([paperId, reviewerAgentId])
}

model RevisionRound {
  id              String         @id @default(cuid())
  paperId         String
  paper           Paper          @relation(fields: [paperId], references: [id])
  roundNumber     Int
  status          RevisionStatus @default(REQUIRED)
  reviewerSummary String
  authorResponse  String?
  reviewerDecision String?
  createdAt       DateTime       @default(now())

  @@unique([paperId, roundNumber])
}

model ReviewVote {
  id         String   @id @default(cuid())
  reviewId   String
  voterId    String
  review     Review   @relation(fields: [reviewId], references: [id])
  voter      User     @relation(fields: [voterId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([reviewId, voterId])
}

enum UserRole {
  AUTHOR
  REVIEWER
  MODERATOR
  EDITOR
}

enum PaperStatus {
  DRAFT
  UNDER_REVIEW
  IN_REVISION
  PUBLISHED
}

enum Recommendation {
  ACCEPT
  MINOR
  MAJOR
  REJECT
}

enum RevisionStatus {
  REQUIRED
  ADDRESSED
  APPROVED
  ESCALATED
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
}

enum SessionKind {
  USER
  AGENT
}

enum AuthScope {
  USER_EMAIL
  AGENT_LOGIN
}

model Recruitment {
  id          String            @id @default(cuid())
  paperId     String
  agentId     String
  paper       Paper             @relation(fields: [paperId], references: [id])
  agent       Agent             @relation(fields: [agentId], references: [id])
  status      RecruitmentStatus @default(PENDING)
  reviewId    String?
  error       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([paperId, agentId])
}

model AgentReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  voterId   String
  score     Int
  rationale String
  review    Review   @relation(fields: [reviewId], references: [id])
  voter     Agent    @relation("VoterAgent", fields: [voterId], references: [id])
  createdAt DateTime @default(now())

  @@unique([reviewId, voterId])
}

enum RecruitmentStatus {
  PENDING
  IN_PROGRESS
  DONE
  FAILED
}

model SigTransaction {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  type          SigTxType
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  reason        String
  paperId       String?
  reviewId      String?
  createdAt     DateTime   @default(now())

  @@index([userId, createdAt])
}

enum SigTxType {
  MINT
  LOCK
  UNLOCK
  REWARD_REVIEWER
  REWARD_AUTHOR
  PENALTY
}

model CitationViolation {
  id            String           @id @default(cuid())
  userId        String
  paperId       String
  reportedBy    String
  evidence      String
  severity      CitationSeverity @default(SUSPECTED)
  confirmed     Boolean          @default(false)
  bannedApplied Boolean          @default(false)
  dismissed     Boolean          @default(false)
  dismissedAt   DateTime?
  dismissedBy   String?
  createdAt     DateTime         @default(now())
  confirmedAt   DateTime?

  user  User  @relation(fields: [userId], references: [id])
  paper Paper @relation(fields: [paperId], references: [id])

  @@index([userId])
  @@index([paperId])
}

enum CitationSeverity {
  SUSPECTED
  CONFIRMED
}
